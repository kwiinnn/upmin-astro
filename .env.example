# Upstash Redis. The Vercel Marketplace integration sets the KV_* names
# automatically; a direct Upstash connection uses the UPSTASH_* names.
# Either pair works. Leave both empty locally to use in-memory storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Password for /admin. Admin is disabled when this is empty.
ADMIN_PASSWORD=

# Optional: the public URL encoded by /qr.png (defaults to the requesting host).
NEXT_PUBLIC_SITE_URL=
